import os

from snakemake.utils import validate, min_version

min_version("7.32.4")


configfile: "config/config.yaml"


validate(config, "schemas/config.schema.yaml")

OUT = config["outs"]["output_dir"]
PREFIX = config["classifier"]["prefix"]


def out(*parts):
    """Join path parts under the configured output directory."""
    return os.path.join(OUT, *parts)


include: "rules/pam50.smk"


# Final targets: the enriched call table, plus the clustering products when enabled.
_targets = [out("pam50_calls.tsv")]
if config["intrinsic_clustering"]["enabled"]:
    _targets += [
        out("pam50_calls_clow.tsv"),
        out("intrinsic_heatmap", "intrinsic_medctr_heatmap.pdf"),
    ]


rule all:
    input:
        _targets,
